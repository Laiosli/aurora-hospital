# Copie para .env. Apenas demonstração; nunca insira pacientes reais.
APP_ENV=demonstracao
DB_MODE=pglite
PGLITE_PATH=./data/demo
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# PostgreSQL: DB_MODE=postgres e DATABASE_URL obrigatória
# DATABASE_URL=postgresql://aurora:SUBSTITUIR@localhost:5432/aurora
# Defina antes do seed: senha forte própria (mínimo 14 caracteres).
DEMO_PASSWORD=
# Base32 aleatória, no mínimo 32 caracteres; obrigatória para o perfil técnico.
ADMIN_TOTP_SECRET=
# Backup demonstrativo: gere com npm run backup:setup. Guarde a chave separadamente.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=./private-backups
