{
  "name": "aurora-hospital",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.server.json server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json && vite build",
    "start": "node dist/server/main.js",
    "test": "tsx --tsconfig tsconfig.server.json --test tests/*.test.ts",
    "seed": "tsx --tsconfig tsconfig.server.json server/seed.ts",
    "seed:operations": "tsx --tsconfig tsconfig.server.json server/seed-operations.ts",
    "migrate": "tsx --tsconfig tsconfig.server.json server/migrate.ts",
    "backup:setup": "node scripts/setup-backups.cjs",
    "backup:restore": "tsx --tsconfig tsconfig.server.json server/restore-backup.ts",
    "benchmark:local": "tsx --tsconfig tsconfig.server.json server/benchmark-local.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@electric-sql/pglite-tools": "0.2.21",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "overrides": {
    "multer": "2.5.0",
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}